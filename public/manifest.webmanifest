{
  "id": "./",
  "name": "Workbench",
  "short_name": "Workbench",
  "description": "Projects, timesheets, tasks, notes, whiteboards, PDFs and a speed reader.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b0c10",
  "theme_color": "#0b0c10",
  "categories": ["productivity", "business", "books"],
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Speed Reader", "short_name": "Read", "url": "./#/read", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Timesheet", "short_name": "Log time", "url": "./#/timesheet", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Tasks", "url": "./#/tasks", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "PDF Studio", "short_name": "PDFs", "url": "./#/pdf", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["application/pdf", ".pdf", "application/epub+zip", ".epub", "application/vnd.openxmlformats-officedocument.wordprocessingml.document", ".docx", "text/plain", "text/markdown", "text/html", ".txt", ".md", ".html", ".rtf", "image/*"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [".pdf"],
        "application/epub+zip": [".epub"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
        "text/markdown": [".md", ".markdown"],
        "text/plain": [".txt"]
      }
    }
  ]
}
